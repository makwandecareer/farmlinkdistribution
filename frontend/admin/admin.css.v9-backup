:root{--green-950:#05271c;--green-900:#073827;--green-800:#0b4a35;--green-700:#0d6547;--green-100:#e8f2ed;--gold:#c79a36;--gold-soft:#f7edd7;--ink:#17201c;--muted:#6b766f;--line:#e1e7e3;--surface:#fff;--canvas:#f4f7f5;--danger:#a82e2e;--shadow:0 18px 50px rgba(7,56,39,.11);--radius:16px}*{box-sizing:border-box}html{font-size:16px}body{margin:0;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--canvas);line-height:1.5}button,input,select,textarea{font:inherit}.hidden{display:none!important}.muted{color:var(--muted)}.kicker{display:block;color:var(--gold);font-size:.7rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.kicker.light{color:#eac66f}.login-shell{min-height:100vh;display:grid;grid-template-columns:minmax(420px,1.15fr) minmax(420px,.85fr);background:#fff}.login-visual{position:relative;min-height:100vh;background:url('/assets/distribution-centre.png') center/cover}.login-overlay{position:absolute;inset:0;background:linear-gradient(125deg,rgba(3,35,24,.95),rgba(7,56,39,.62))}.login-copy{position:absolute;left:clamp(40px,7vw,110px);bottom:clamp(55px,9vh,100px);max-width:650px;color:white}.login-copy h1{font-size:clamp(2.5rem,4vw,4.6rem);line-height:1.02;margin:.6rem 0 1.3rem;letter-spacing:-.045em}.login-copy p{max-width:600px;font-size:1.08rem;color:#dbe8e2}.login-panel{display:grid;place-items:center;padding:48px}.login-card{width:min(440px,100%)}.login-logo{width:180px;height:auto;margin-bottom:42px}.login-card h2{font-size:2.1rem;letter-spacing:-.035em;margin:.5rem 0}.form-stack{display:grid;gap:18px;margin-top:30px}label{display:grid;gap:8px;font-size:.78rem;font-weight:800;color:#344039}input,select,textarea{width:100%;border:1px solid #ccd5d0;background:#fff;border-radius:10px;padding:12px 13px;outline:none;color:var(--ink);transition:.18s}input:focus,select:focus,textarea:focus{border-color:var(--green-700);box-shadow:0 0 0 4px rgba(13,101,71,.1)}textarea{resize:vertical}.btn{border:0;border-radius:10px;padding:12px 16px;font-weight:850;cursor:pointer;transition:.18s}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--green-900);color:#fff}.btn-secondary{background:#fff;color:var(--green-900);border:1px solid var(--line)}.btn-gold{background:var(--gold);color:#162017}.btn-danger{background:#fff1f1;color:var(--danger);border:1px solid #f1caca}.error{color:var(--danger);min-height:20px;margin:0}.security-note{margin-top:28px;padding-top:20px;border-top:1px solid var(--line);font-size:.75rem;color:var(--muted)}.security-note span{color:#0f8d5d}.app{min-height:100vh;display:grid;grid-template-columns:276px minmax(0,1fr)}.sidebar{height:100vh;position:sticky;top:0;background:linear-gradient(180deg,var(--green-950),var(--green-900));color:white;padding:24px 18px;display:flex;flex-direction:column;overflow:auto}.brand{display:flex;gap:12px;align-items:center;padding:4px 8px 24px;border-bottom:1px solid rgba(255,255,255,.11)}.brand img{width:54px;height:54px;object-fit:contain;background:white;border-radius:12px;padding:4px}.brand strong,.brand span{display:block}.brand strong{font-size:1rem}.brand span{font-size:.72rem;color:#aec6bc}.nav-label{margin:22px 12px 7px;color:#75998a;font-size:.64rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.sidebar nav{display:grid;gap:4px}.sidebar nav button{display:flex;align-items:center;gap:12px;border:0;background:transparent;color:#bfd1c9;text-align:left;padding:10px 12px;border-radius:9px;font-size:.82rem;font-weight:750;cursor:pointer}.sidebar nav button span{width:20px;text-align:center;color:#e3bd62}.sidebar nav button:hover,.sidebar nav button.active{background:rgba(255,255,255,.105);color:white}.sidebar-user{margin-top:auto;display:grid;grid-template-columns:38px 1fr 30px;gap:10px;align-items:center;padding:18px 8px 4px;border-top:1px solid rgba(255,255,255,.11)}.avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--gold);color:var(--green-950);font-size:.72rem;font-weight:900}.sidebar-user strong,.sidebar-user span{display:block}.sidebar-user strong{font-size:.78rem}.sidebar-user span{font-size:.66rem;color:#9fb9ae}.sidebar-user button{border:0;background:transparent;color:white;font-size:1.2rem;cursor:pointer}.workspace{min-width:0}.topbar{height:88px;display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.96);border-bottom:1px solid var(--line);padding:0 34px;position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}.topbar h1{font-size:1.35rem;margin:.15rem 0 0;letter-spacing:-.025em}.top-actions{display:flex;align-items:center;gap:12px}.health{display:flex;align-items:center;gap:7px;font-size:.75rem;font-weight:800;color:var(--green-700)}.health i{width:8px;height:8px;border-radius:50%;background:#1caf73;box-shadow:0 0 0 5px #1caf7318}.view{display:none;padding:30px 34px 60px}.view.active{display:block}.command-banner{display:grid;grid-template-columns:1fr auto;gap:28px;align-items:end;background:linear-gradient(115deg,var(--green-900),var(--green-700));color:#fff;padding:28px 30px;border-radius:var(--radius);box-shadow:var(--shadow)}.command-banner h2{font-size:1.75rem;line-height:1.18;letter-spacing:-.03em;margin:.45rem 0 .55rem}.command-banner p{margin:0;color:#dbe8e2}.command-date{text-align:right}.command-date strong,.command-date span{display:block}.command-date strong{font-size:1rem}.command-date span{font-size:.72rem;color:#c2d8cf}.metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;margin:18px 0}.metric{background:#fff;border:1px solid var(--line);border-radius:13px;padding:18px;min-width:0}.metric .label{font-size:.68rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:850}.metric strong{display:block;font-size:1.65rem;color:var(--green-900);margin-top:6px;letter-spacing:-.035em}.metric small{font-size:.68rem;color:var(--muted)}.grid-2{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.6fr);gap:18px}.grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.panel{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:0 7px 25px rgba(7,56,39,.035)}.panel-head,.page-head{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:20px 22px;border-bottom:1px solid var(--line)}.page-head{padding:0 0 22px;border:0}.page-head h2,.panel-head h3{margin:.25rem 0 0;letter-spacing:-.025em}.page-head h2{font-size:1.75rem}.panel-body{padding:20px 22px}.toolbar{display:flex;gap:9px;align-items:center}.toolbar input{min-width:260px}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:760px}.table th{text-align:left;background:#f8faf9;padding:12px 16px;font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);white-space:nowrap}.table td{padding:14px 16px;border-top:1px solid var(--line);font-size:.8rem;vertical-align:middle}.table tbody tr:hover{background:#fbfcfb}.ref{font-size:.68rem;color:var(--muted);margin-top:2px}.status{display:inline-flex;align-items:center;border-radius:99px;padding:5px 9px;font-size:.64rem;font-weight:900;background:#eef1ef;color:#59645f}.status.Pending,.status.Scheduled,.status.Queued,.status.Unpaid{background:#fff3d6;color:#8a6314}.status.Approved,.status.Completed,.status.Paid,.status.Delivered,.status.Available,.status.Sent,.status.Resolved{background:#dff4e8;color:#12633e}.status.Rejected,.status.Failed,.status.Cancelled,.status.Damaged{background:#fde5e5;color:#982d2d}.status.In-progress,.status.Invoiced,.status.Part-paid,.status.Dispatched,.status.Open{background:#e4eef9;color:#2b5e89}.link-btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 10px;font-size:.7rem;font-weight:800;cursor:pointer}.empty{padding:42px;text-align:center;color:var(--muted)}.list-item{display:grid;grid-template-columns:minmax(0,1.4fr) .75fr .75fr auto;gap:14px;align-items:center;padding:14px 20px;border-top:1px solid var(--line);font-size:.8rem}.chart{height:235px;padding:20px;display:flex;align-items:end;gap:10px}.chart-col{flex:1;display:grid;align-content:end;gap:7px;height:100%;text-align:center}.chart-bar{width:100%;min-height:4px;border-radius:6px 6px 2px 2px;background:linear-gradient(180deg,var(--gold),#e2bd68)}.chart-col span{font-size:.64rem;color:var(--muted)}.rank-list{padding:8px 20px 18px}.rank-item{display:grid;grid-template-columns:26px 1fr auto;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line);font-size:.78rem}.rank-item:last-child{border:0}.rank-num{width:24px;height:24px;display:grid;place-items:center;border-radius:7px;background:var(--green-100);color:var(--green-900);font-weight:900;font-size:.66rem}.drawer{position:fixed;z-index:40;right:0;top:0;height:100vh;width:min(620px,100%);background:#fff;box-shadow:-20px 0 70px rgba(0,0,0,.22);padding:34px;overflow:auto}.modal{position:fixed;z-index:40;left:50%;top:50%;transform:translate(-50%,-50%);width:min(570px,calc(100% - 28px));max-height:90vh;overflow:auto;background:#fff;border-radius:18px;padding:30px;box-shadow:0 30px 100px rgba(0,0,0,.3)}.backdrop{position:fixed;inset:0;background:rgba(2,22,15,.68);z-index:30;backdrop-filter:blur(4px)}.icon-btn{position:absolute;right:18px;top:14px;border:0;background:transparent;font-size:1.8rem;cursor:pointer}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin:22px 0}.detail{padding:12px;background:#f6f8f7;border-radius:9px;overflow:hidden}.detail span,.detail strong{display:block}.detail span{font-size:.62rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}.detail strong{font-size:.8rem;margin-top:4px;overflow-wrap:anywhere}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-grid .full{grid-column:1/-1}.form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}.toast{position:fixed;right:20px;bottom:20px;z-index:60;background:var(--green-700);color:white;padding:13px 17px;border-radius:10px;box-shadow:var(--shadow);opacity:0;transform:translateY(8px);pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:none}@media(max-width:1180px){.metrics{grid-template-columns:repeat(3,1fr)}.grid-2{grid-template-columns:1fr}.app{grid-template-columns:230px}.view{padding:24px}.topbar{padding:0 24px}}@media(max-width:820px){.login-shell{grid-template-columns:1fr}.login-visual{display:none}.app{display:block}.sidebar{height:auto;position:relative}.sidebar nav{grid-template-columns:1fr 1fr}.nav-label{grid-column:1/-1}.sidebar-user{margin-top:20px}.topbar{position:relative}.metrics{grid-template-columns:1fr 1fr}.command-banner{grid-template-columns:1fr}.command-date{text-align:left}.toolbar{display:grid;width:100%}.toolbar input{min-width:0}.page-head{align-items:flex-start;flex-direction:column}.grid-3{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.form-grid .full{grid-column:auto}}@media(max-width:520px){.login-panel{padding:28px 20px}.metrics{grid-template-columns:1fr}.view{padding:18px 12px}.topbar{padding:0 14px}.health{display:none}.sidebar nav{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}}

/* FarmLink Administration v3.0 refinements */
.top-icon{display:none}.account-menu{position:relative}.account-trigger{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:#fff;border-radius:12px;padding:7px 10px;cursor:pointer;color:var(--ink)}.avatar.mini{width:34px;height:34px;font-size:.68rem}.account-copy{display:grid;text-align:left;line-height:1.2}.account-copy strong{font-size:.76rem}.account-copy small{font-size:.65rem;color:var(--muted)}.account-dropdown{position:absolute;right:0;top:calc(100% + 8px);width:210px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow);border-radius:12px;padding:7px;z-index:25}.account-dropdown button{display:block;width:100%;border:0;background:transparent;text-align:left;padding:10px 11px;border-radius:8px;cursor:pointer;font-weight:750;color:var(--ink)}.account-dropdown button:hover{background:var(--green-100)}
.quick-actions{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin:18px 0}.quick-action{border:1px solid var(--line);background:#fff;border-radius:13px;padding:15px;display:flex;align-items:center;gap:11px;text-align:left;cursor:pointer;transition:.18s;box-shadow:0 8px 25px rgba(7,56,39,.04)}.quick-action:hover{transform:translateY(-2px);border-color:#bad4c8;box-shadow:0 12px 30px rgba(7,56,39,.09)}.quick-action .qa-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:var(--green-100);color:var(--green-800);font-weight:900}.quick-action strong,.quick-action span{display:block}.quick-action strong{font-size:.78rem}.quick-action span{font-size:.66rem;color:var(--muted);margin-top:2px}
.metric{position:relative;overflow:hidden}.metric:after{content:"";position:absolute;width:72px;height:72px;border-radius:50%;right:-25px;top:-25px;background:linear-gradient(145deg,rgba(199,154,54,.18),rgba(13,101,71,.05))}.metric .metric-icon{width:35px;height:35px;border-radius:10px;background:var(--green-100);display:grid;place-items:center;color:var(--green-800);font-weight:900;margin-bottom:12px}.metric strong{letter-spacing:-.035em}.panel{box-shadow:0 8px 24px rgba(7,56,39,.045)}.panel-head h3{letter-spacing:-.025em}.empty-state{min-height:235px;display:grid;place-items:center;text-align:center;padding:32px}.empty-state .empty-icon{width:48px;height:48px;border-radius:14px;background:var(--green-100);display:grid;place-items:center;color:var(--green-700);font-size:1.2rem;margin:0 auto 12px}.empty-state strong{display:block;margin-bottom:4px}.empty-state p{color:var(--muted);font-size:.8rem;max-width:280px;margin:0 auto}.chart{min-height:230px;padding:25px 22px 12px;background:linear-gradient(180deg,#fff,#fbfdfc)}.chart-col{position:relative}.chart-bar{border-radius:8px 8px 3px 3px;background:linear-gradient(180deg,var(--green-700),var(--green-900));box-shadow:inset 0 1px rgba(255,255,255,.25)}.chart-col:after{content:"";position:absolute;left:0;right:0;bottom:25px;border-bottom:1px dashed #dce5e0;z-index:-1}.mobile-backdrop{position:fixed;inset:0;background:rgba(0,26,18,.55);z-index:35}.loading{position:relative;overflow:hidden;background:#eef3f0!important;color:transparent!important;border-color:transparent!important}.loading:after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent);animation:shimmer 1.3s infinite}@keyframes shimmer{100%{transform:translateX(100%)}}
@media(max-width:1250px){.quick-actions{grid-template-columns:repeat(3,1fr)}.account-copy{display:none}}
@media(max-width:900px){.top-icon{display:inline-grid;place-items:center}.sidebar{position:fixed;left:-290px;z-index:40;transition:left .22s}.sidebar.open{left:0}.app{grid-template-columns:1fr}.topbar{padding:0 18px}.view{padding:22px 18px 50px}.quick-actions{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.health{display:none}.quick-actions{grid-template-columns:1fr}.top-actions{gap:7px}.topbar h1{font-size:1.05rem}.command-banner{padding:24px}.command-banner h2{font-size:1.45rem}.metrics{grid-template-columns:1fr 1fr}.metric{padding:16px}.metric strong{font-size:1.35rem}.account-trigger{padding:6px}.account-trigger>span:last-child{display:none}}

/* FarmLink Admin V4 — executive productivity layer */
:root{--focus:#0d6547;--glass:rgba(255,255,255,.86)}
body.dark{--ink:#edf5f1;--muted:#9fb0a8;--line:#294239;--surface:#102a20;--canvas:#091c15;--green-100:#173c2e;--shadow:0 18px 50px rgba(0,0,0,.28)}
body.dark .workspace,body.dark .topbar,body.dark .panel,body.dark .metric,body.dark .drawer,body.dark .modal,body.dark input,body.dark select,body.dark textarea,body.dark .btn-secondary,body.dark .account-trigger,body.dark .account-dropdown,body.dark .notification-dropdown,body.dark .search-dialog{background:var(--surface);color:var(--ink)}
body.dark .table th{background:#153327}body.dark .table tbody tr:hover{background:#143126}body.dark .detail{background:#163228}body.dark .link-btn{background:#153027;color:var(--ink)}
.global-search-trigger{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--surface);color:var(--muted);height:42px;padding:0 10px 0 13px;border-radius:10px;cursor:pointer}.global-search-trigger strong{font-size:.75rem;color:var(--ink)}kbd{font:700 .64rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:4px 6px;background:var(--canvas);color:var(--muted)}
.notification-menu{position:relative}.notification-badge{position:absolute;right:-4px;top:-5px;min-width:18px;height:18px;padding:0 5px;border-radius:99px;display:grid;place-items:center;background:#c43b3b;color:#fff;font-size:.6rem;font-weight:900;border:2px solid var(--surface)}.notification-dropdown{position:absolute;right:0;top:50px;width:min(380px,calc(100vw - 28px));background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 24px 70px rgba(0,0,0,.18);z-index:70;overflow:hidden}.notification-head{display:flex;align-items:center;justify-content:space-between;padding:15px 17px;border-bottom:1px solid var(--line)}.notification-head button{border:0;background:none;color:var(--green-700);font-size:.7rem;font-weight:800;cursor:pointer}.notification-item{display:grid;grid-template-columns:9px 1fr;gap:11px;padding:13px 17px;border-bottom:1px solid var(--line)}.notification-item:last-child{border:0}.notification-dot{width:8px;height:8px;border-radius:50%;background:var(--gold);margin-top:6px}.notification-item strong,.notification-item span{display:block}.notification-item strong{font-size:.77rem}.notification-item span{font-size:.68rem;color:var(--muted);margin-top:2px}
.search-overlay{position:fixed;inset:0;z-index:90;background:rgba(2,18,13,.7);backdrop-filter:blur(6px);padding:8vh 20px}.search-dialog{width:min(760px,100%);margin:auto;background:#fff;border-radius:18px;box-shadow:0 35px 110px rgba(0,0,0,.35);overflow:hidden}.search-box{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:18px 20px;border-bottom:1px solid var(--line)}.search-box input{border:0;box-shadow:none!important;padding:5px;font-size:1.05rem}.search-results{max-height:62vh;overflow:auto;padding:10px}.search-hint{padding:35px;text-align:center;color:var(--muted)}.search-result{display:grid;grid-template-columns:1fr auto;gap:14px;padding:13px 14px;border-radius:10px;cursor:pointer}.search-result:hover{background:var(--canvas)}.search-result strong,.search-result span{display:block}.search-result span{font-size:.7rem;color:var(--muted)}
.quick-actions{display:flex;flex-wrap:wrap;gap:10px;margin:18px 0}.quick-action{display:flex;align-items:center;gap:9px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;padding:10px 13px;font-size:.73rem;font-weight:850;cursor:pointer;box-shadow:0 5px 16px rgba(7,56,39,.04)}.quick-action:hover{border-color:var(--green-700);transform:translateY(-1px)}.quick-action b{width:24px;height:24px;border-radius:7px;display:grid;place-items:center;background:var(--green-100);color:var(--green-900)}
.metric{position:relative;overflow:hidden}.metric-icon{position:absolute;right:14px;top:14px;width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:var(--green-100);color:var(--green-900);font-weight:900}.metric-trend{display:inline-flex;gap:4px;align-items:center;margin-top:7px;font-size:.65rem;color:var(--green-700);font-weight:800}
.chart-wrap{height:270px;padding:18px 20px}.chart-wrap canvas{width:100%!important;height:100%!important}.empty-action{padding:44px 24px;text-align:center}.empty-action .empty-icon{width:48px;height:48px;border-radius:14px;margin:0 auto 12px;display:grid;place-items:center;background:var(--green-100);color:var(--green-900);font-size:1.25rem}.empty-action h4{margin:0 0 5px}.empty-action p{margin:0 auto 16px;color:var(--muted);font-size:.76rem;max-width:320px}
.skeleton{position:relative;overflow:hidden;background:#e8edea;border-radius:9px;min-height:16px}.skeleton::after{content:"";position:absolute;inset:0;transform:translateX(-100%);background:linear-gradient(90deg,transparent,rgba(255,255,255,.75),transparent);animation:shimmer 1.25s infinite}@keyframes shimmer{100%{transform:translateX(100%)}}.skeleton-page{display:grid;gap:16px}.skeleton-banner{height:140px}.skeleton-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.skeleton-card{height:120px}.skeleton-panel{height:310px}
.table-tools{display:flex;justify-content:flex-end;gap:8px;padding:11px 14px;border-bottom:1px solid var(--line)}.table-tools button{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:7px 10px;font-size:.67rem;font-weight:800;cursor:pointer}.table th.sortable{cursor:pointer;user-select:none}.table th.sortable::after{content:' ↕';opacity:.35}.table th.sort-asc::after{content:' ↑';opacity:1}.table th.sort-desc::after{content:' ↓';opacity:1}
.nav-icon{width:18px;height:18px;display:inline-grid!important;place-items:center}.nav-icon svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
@media(max-width:1050px){.global-search-trigger strong,.global-search-trigger kbd{display:none}.skeleton-cards{grid-template-columns:repeat(3,1fr)}}
@media(max-width:620px){.global-search-trigger{width:42px;padding:0;justify-content:center}.quick-actions{display:grid;grid-template-columns:1fr 1fr}.skeleton-cards{grid-template-columns:1fr 1fr}}


/* FarmLink Admin V5 — precision alignment and enterprise polish */
html,body{min-width:320px}
body{overflow-x:hidden}
button{white-space:nowrap}
.workspace{width:100%;overflow:hidden}
.topbar{min-height:88px;height:auto;padding-block:14px;gap:24px}
.topbar>div:first-child{min-width:190px;flex:0 0 auto}
.top-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;min-width:0;flex:1;flex-wrap:nowrap}
.top-actions .icon-btn{position:static;right:auto;top:auto;width:42px;height:42px;padding:0;border:1px solid var(--line);border-radius:10px;background:var(--surface);font-size:1rem;color:var(--ink);display:grid;place-items:center;flex:0 0 42px}
.top-actions .icon-btn:hover{border-color:#b9d1c5;background:var(--green-100)}
#mobileNav{display:none}
.global-search-trigger{height:42px;min-width:150px;justify-content:flex-start;flex:0 1 210px;overflow:hidden}
.global-search-trigger .search-symbol{font-size:1rem;flex:0 0 auto}
.global-search-trigger strong{overflow:hidden;text-overflow:ellipsis}
.global-search-trigger kbd{margin-left:auto;flex:0 0 auto}
.health{height:42px;padding:0 10px;border-radius:10px;background:#f5faf7;flex:0 0 auto}
#refresh{height:42px;display:inline-flex;align-items:center;justify-content:center;padding:0 16px;flex:0 0 auto}
.account-menu{position:relative;flex:0 0 auto}
.account-trigger{height:48px;min-width:188px;max-width:230px;padding:6px 10px;border-radius:12px;overflow:hidden}
.account-trigger .avatar.mini{width:34px;height:34px;flex:0 0 34px}
.account-copy{display:flex;flex-direction:column;min-width:0;flex:1;text-align:left;line-height:1.15}
.account-copy strong,.account-copy small{display:block;max-width:138px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.account-copy strong{font-size:.76rem;color:var(--ink)}
.account-copy small{font-size:.64rem;color:var(--muted);margin-top:3px}
.account-chevron{font-size:.8rem;color:var(--muted);flex:0 0 auto}
.account-dropdown{right:0;min-width:220px}
.notification-menu{flex:0 0 auto}
.command-banner{align-items:center;min-height:142px}
.metrics{align-items:stretch}
.metric{min-height:128px;display:flex;flex-direction:column;justify-content:flex-start}
.metric strong{line-height:1.1}
.metric small{margin-top:8px;line-height:1.35}
.metric-trend{margin-top:auto;padding-top:9px}
.grid-2{align-items:stretch}
.grid-2>.panel{height:100%}
.panel-head{min-height:88px}
.chart-wrap{height:320px;position:relative}
.chart-empty{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px;color:var(--muted)}
.chart-empty-icon{width:52px;height:52px;border-radius:14px;background:var(--green-100);color:var(--green-700);display:grid;place-items:center;font-size:1.35rem;margin-bottom:12px}
.chart-empty strong{color:var(--ink);font-size:.95rem}
.chart-empty p{margin:5px 0 0;font-size:.76rem}
.row-actions{display:flex;align-items:center;justify-content:flex-start;gap:6px;flex-wrap:nowrap}
.approve-btn,.reject-btn,.link-btn{min-height:32px;display:inline-flex;align-items:center;justify-content:center}
.approve-btn,.reject-btn{border-radius:8px;padding:7px 10px;font-size:.7rem;font-weight:850;cursor:pointer}
.approve-btn{border:1px solid #b9dfcc;background:#e8f7ef;color:#0d6547}.approve-btn:hover{background:#d7f0e2}
.reject-btn{border:1px solid #f0c4c4;background:#fff1f1;color:#a82e2e}.reject-btn:hover{background:#fde3e3}
.table td:last-child,.table th:last-child{text-align:right}
.table td:last-child .row-actions{justify-content:flex-end}
.sidebar nav button{min-height:42px}
.sidebar nav button .nav-icon{flex:0 0 18px}
.toast{max-width:min(420px,calc(100vw - 32px))}

@media(max-width:1400px){
  .topbar{padding-inline:24px}.view{padding-inline:24px}
  .global-search-trigger{min-width:42px;flex-basis:42px;padding:0;justify-content:center}
  .global-search-trigger strong,.global-search-trigger kbd{display:none}
  .account-trigger{min-width:48px;width:48px;padding:6px}
  .account-copy,.account-chevron{display:none}
}
@media(max-width:1180px){
  .health{display:none}.metrics{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:900px){
  #mobileNav{display:grid}.topbar>div:first-child{min-width:0}.topbar{padding-inline:16px}.top-actions{gap:7px}
  #refresh{padding-inline:12px}.view{padding-inline:16px}.command-banner{min-height:auto}
}
@media(max-width:700px){
  .topbar{align-items:flex-start}.topbar>div:first-child{padding-top:4px}.top-actions{flex-wrap:wrap;justify-content:flex-end}
  #refresh{display:none}.notification-menu,.health{display:none}.account-trigger{width:42px;height:42px}.account-trigger .avatar.mini{width:30px;height:30px}
  .metrics{grid-template-columns:1fr 1fr}.panel-head{min-height:auto}.row-actions{flex-wrap:wrap}.table td:last-child .row-actions{justify-content:flex-start}
}
@media(max-width:460px){
  .topbar h1{font-size:1rem}.topbar .kicker{font-size:.58rem}.metrics{grid-template-columns:1fr}.command-banner{padding:22px 20px}.command-date{margin-top:8px}
}


/* FarmLink V6 provincial formality and precision layer */
.metric{position:relative;isolation:isolate}
.metric::before{content:"";position:absolute;inset:0 auto 0 0;width:4px;border-radius:13px 0 0 13px;background:var(--green-700)}
.metric-emerald::before{background:#0e9f6e}.metric-forest::before{background:#073827}.metric-gold::before{background:#c79a36}.metric-blue::before{background:#2f6f9f}.metric-teal::before{background:#17827a}
.metric-emerald .metric-icon{background:#e3f6ef;color:#087753}.metric-forest .metric-icon{background:#e5eee9;color:#073827}.metric-gold .metric-icon{background:#fbf1d9;color:#8a6518}.metric-blue .metric-icon{background:#e6f0f8;color:#2f6f9f}.metric-teal .metric-icon{background:#e4f5f3;color:#126d66}
.province-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:#eef6f1;color:#0b5b40;font-size:.68rem;font-weight:850;white-space:nowrap;border:1px solid #d9e9df}
.province-chip::before{content:"";width:6px;height:6px;border-radius:50%;background:#c79a36}
.province-panel{margin-top:18px}
.province-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:18px 20px 22px}
.province-card{display:grid;gap:4px;padding:15px 16px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(145deg,#fff,#f8fbf9)}
.province-card strong{font-size:.82rem;color:var(--green-900)}
.province-card span{font-size:.7rem;color:var(--muted)}
.formal-badge{display:inline-flex;align-items:center;border:1px solid #ead8ad;background:#fff8e8;color:#7a5a17;padding:7px 10px;border-radius:999px;font-size:.66rem;font-weight:900;letter-spacing:.04em}
.toolbar select{min-width:170px}
.top-actions{min-width:0}
.account-trigger{max-width:260px}
.account-copy{min-width:0}
.account-copy strong,.account-copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.health i{animation:farmPulse 2.3s ease-in-out infinite}
@keyframes farmPulse{0%,100%{box-shadow:0 0 0 4px rgba(28,175,115,.12)}50%{box-shadow:0 0 0 8px rgba(28,175,115,.04)}}
.dark .province-card{background:linear-gradient(145deg,#12271f,#0f211b);border-color:#28463a}
.dark .province-chip{background:#17392c;color:#cde7da;border-color:#28523f}
@media(max-width:1180px){.province-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:720px){.province-grid{grid-template-columns:1fr}.toolbar select{min-width:0;width:100%}.formal-badge{margin-top:8px}}


/* FarmLink V6.1 — CEO administrator management activation */
.admin-add-btn{min-width:170px}
.admin-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 18px}
.admin-summary article{background:var(--surface);border:1px solid var(--line);border-radius:13px;padding:16px 18px;box-shadow:0 7px 25px rgba(7,56,39,.035)}
.admin-summary span{display:block;color:var(--muted);font-size:.68rem;font-weight:850;text-transform:uppercase;letter-spacing:.06em}
.admin-summary strong{display:block;margin-top:5px;color:var(--green-900);font-size:1.25rem}
.admin-identity{display:flex;align-items:center;gap:10px;min-width:210px}
.admin-avatar{width:34px;height:34px;flex:0 0 34px;display:grid;place-items:center;border-radius:10px;background:linear-gradient(145deg,var(--gold),#e7c777);color:var(--green-950);font-size:.66rem;font-weight:950}
.protected-owner{display:inline-flex;padding:7px 10px;border-radius:999px;background:#fff7df;color:#7a5a17;border:1px solid #ebd8a4;font-size:.68rem;font-weight:900}
.danger-action{color:var(--danger);border-color:#efcdcd;background:#fffafa}
.danger-action:hover{background:#fff0f0}
.admin-security-note{padding:12px 14px;border-radius:10px;background:#f5f8f6;border:1px solid var(--line);font-size:.73rem;color:var(--muted)}
@media(max-width:1100px){.admin-summary{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.admin-summary{grid-template-columns:1fr}.admin-add-btn{width:100%}}

/* FarmLink Administrator Governance V7.1 */
.admin-action-cell{display:flex;align-items:center;justify-content:flex-end;gap:8px}
.compact{padding:7px 10px;font-size:.7rem}
.icon-action{width:34px;height:34px;border:1px solid var(--line);background:var(--surface);border-radius:9px;font-size:1.05rem;cursor:pointer;font-weight:900}
.icon-action:hover{border-color:var(--green-600);background:#f4f8f6}
.admin-action-menu{display:grid;gap:9px;margin-top:22px}
.admin-action-menu button{width:100%;text-align:left;padding:13px 14px;border:1px solid var(--line);background:#fff;border-radius:10px;font-weight:800;cursor:pointer}
.admin-action-menu button:hover{border-color:var(--green-600);background:#f5f9f7}
.admin-action-menu button.danger{color:var(--danger);border-color:#efcdcd;background:#fffafa}
.dark .admin-action-menu button,.dark .icon-action{background:#12271f;border-color:#2a453a;color:#e9f3ee}
@media(max-width:720px){.admin-action-cell{justify-content:flex-start}.compact{display:none}}


/* FarmLink Administrator Management Final V8 */
.admin-controls{margin:0 0 14px;padding:12px 14px;background:var(--surface);border:1px solid var(--line);border-radius:13px}
.admin-controls input{min-width:330px;flex:1}
.admin-controls select{min-width:170px}
.role-badge{display:inline-flex;align-items:center;gap:7px;margin-top:5px;padding:5px 9px;border-radius:999px;font-size:.66rem;font-weight:900;border:1px solid transparent;white-space:nowrap}
.role-badge i{width:7px;height:7px;border-radius:50%;background:currentColor}
.role-ceo{color:#815d0e;background:#fff6d9;border-color:#ead498}
.role-finance{color:#175f91;background:#e7f2fa;border-color:#c9e0f0}
.role-operations{color:#9a5414;background:#fff0df;border-color:#f0d1ae}
.role-logistics{color:#6b45a2;background:#f0eafa;border-color:#d9caed}
.role-quality{color:#0b7350;background:#e2f5ec;border-color:#c2e8d7}
.role-admin{color:#57655e;background:#edf1ef;border-color:#dbe2de}
.admin-action-cell{min-width:126px}
.protected-owner{white-space:nowrap}
@media(max-width:1100px){.admin-controls{display:grid;grid-template-columns:1fr 1fr}.admin-controls input{grid-column:1/-1;min-width:0}}
@media(max-width:650px){.admin-controls{grid-template-columns:1fr}.admin-controls input{grid-column:auto}.admin-controls select{width:100%;min-width:0}}

/* Administrator drawer reliability patch V8.1 */
.drawer-loading{min-height:220px;display:grid;place-items:center;align-content:center;gap:14px;color:var(--muted)}
.drawer-loading span{width:34px;height:34px;border:3px solid var(--line);border-top-color:var(--green-700);border-radius:50%;animation:drawerSpin .8s linear infinite}
.drawer-loading strong{font-size:.78rem}
@keyframes drawerSpin{to{transform:rotate(360deg)}}

/* Administrator profile drawer V8.2 */
.profile-drawer-head{display:flex;align-items:center;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--line)}
.profile-drawer-head h2{margin:5px 0 4px}
.profile-avatar{width:54px;height:54px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(145deg,var(--gold),#e7c777);color:var(--green-950);font-size:.9rem;font-weight:950;flex:0 0 54px}
.profile-status-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:18px 0}
.profile-section{margin-top:22px}
.profile-section h3{font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:12px}
.profile-governance{display:grid;gap:10px}
.profile-governance>div{padding:13px 14px;border:1px solid var(--line);border-radius:10px;background:#f7faf8}
.profile-governance span,.profile-governance strong{display:block}
.profile-governance span{font-size:.66rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:5px}
.profile-governance strong{font-size:.78rem;color:var(--green-900)}
.drawer-error{min-height:220px;display:grid;place-items:center;align-content:center;text-align:center;gap:10px;padding:24px}
.drawer-error strong{font-size:1rem;color:var(--danger)}
.drawer-error p{color:var(--muted);max-width:330px}
.dark .profile-governance>div{background:#12271f;border-color:#2a453a}

/* Administrator profile helper fix V8.3 */
.profile-section .detail strong{overflow-wrap:anywhere}

/* Responsive administrator audit history V8.4 */
.audit-drawer-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.audit-drawer-head h2{margin:5px 0 4px}
.audit-history-toolbar{margin:16px 0}
.audit-history-toolbar input{width:100%}
.audit-history-list{display:grid;gap:10px}
.audit-history-item{border:1px solid var(--line);border-radius:12px;padding:14px;background:#fff}
.audit-history-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.audit-history-top strong{font-size:.8rem;color:var(--green-900)}
.audit-history-top time{font-size:.67rem;color:var(--muted);white-space:nowrap}
.audit-history-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:10px}
.audit-history-meta span{display:grid;gap:4px;font-size:.72rem;overflow-wrap:anywhere}
.audit-history-meta b{font-size:.6rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.dark .audit-history-item{background:#12271f;border-color:#2a453a}
.dark .audit-history-top{border-color:#2a453a}
@media(max-width:760px){
  .audit-drawer-head{display:block}
  .audit-drawer-head .formal-badge{margin-top:10px}
  .audit-history-meta{grid-template-columns:1fr}
  .audit-history-top{display:grid}
  .audit-history-top time{white-space:normal}
}
@media(max-width:480px){
  .drawer{padding:24px 18px}
  .audit-history-item{padding:12px}
}


/* Marketplace Administration V9 */
.marketplace-metrics{margin-top:18px}
.marketplace-tabs{display:flex;gap:8px;margin:18px 0;border-bottom:1px solid var(--line)}
.marketplace-tabs button{border:0;background:transparent;padding:12px 16px;font-weight:850;color:var(--muted);cursor:pointer;border-bottom:3px solid transparent}
.marketplace-tabs button.active{color:var(--green-900);border-bottom-color:var(--gold)}
.marketplace-tabs button span{display:inline-grid;place-items:center;min-width:22px;height:22px;margin-left:6px;border-radius:99px;background:var(--gold-soft);color:#7b5918;font-size:.68rem}
.marketplace-panel{min-width:0}
.marketplace-panel .table{min-width:1050px}
.dark .marketplace-tabs{border-color:#2a453a}
.dark .marketplace-tabs button.active{color:#f4d990}
@media(max-width:760px){
  .marketplace-tabs{overflow:auto}
  .marketplace-tabs button{white-space:nowrap}
  .marketplace-metrics{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){
  .marketplace-metrics{grid-template-columns:1fr}
}
